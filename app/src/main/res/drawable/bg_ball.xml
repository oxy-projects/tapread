<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/icon_ripple">
    <item>
        <layer-list>
            <item android:left="8dp" android:right="8dp" android:top="10dp" android:bottom="6dp">
                <shape android:shape="oval"><solid android:color="@color/icon_shadow" /></shape>
            </item>
            <item android:left="8dp" android:right="8dp" android:top="8dp" android:bottom="8dp">
                <shape android:shape="oval">
                    <solid android:color="@color/icon_warm_white" />
                    <stroke android:width="1dp" android:color="@color/icon_outline" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:id="@android:id/mask">
        <inset android:inset="8dp"><shape android:shape="oval"><solid android:color="#FFFFFF" /></shape></inset>
    </item>
</ripple>
