<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="76dp"
    android:layout_height="76dp">

    <!-- Animate only this visual; the transparent button keeps a stable touch target. -->
    <FrameLayout
        android:id="@+id/ballVisual"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_gravity="center">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_ball"
            android:importantForAccessibility="no"
            android:padding="20dp"
            android:src="@drawable/ic_read_mark"
            android:scaleType="fitCenter" />

        <com.dlwangsan.tapread.overlay.AiRingView
            android:id="@+id/aiRing"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no" />
    </FrameLayout>

    <ImageButton
        android:id="@+id/btnBall"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_gravity="center"
        android:background="@android:color/transparent"
        android:contentDescription="@string/read_clipboard"
        android:padding="0dp" />
</FrameLayout>
